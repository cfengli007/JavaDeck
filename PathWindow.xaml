<Window x:Class="JavaDeck.PathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="JavaDeck.ico"
        Title="JDK 的 PATH 顺序" Height="560" Width="780" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="JDK 的 PATH 顺序" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="这里只列出 JDK。调整顺序只会改变 JDK 之间的相对位置，其它所有路径保持原样不动。"
                       Foreground="{DynamicResource FgDim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <TextBlock x:Name="ScopeText" FontSize="11" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="从上到下：越靠前，java 命令越优先用它"
                           FontSize="11" Foreground="{DynamicResource FgDim}" Margin="16,12,16,8"/>
                <ListBox x:Name="JdkPathList" Grid.Row="1" Background="Transparent" Margin="6,0,6,6"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="↑ 上移" Style="{StaticResource FlatButton}" Click="OnMoveUp" Margin="0,0,8,0"/>
                <Button Content="↓ 下移" Style="{StaticResource FlatButton}" Click="OnMoveDown" Margin="0,0,8,0"/>
                <Button Content="从 PATH 移除" Style="{StaticResource GhostButton}" Click="OnRemove"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" Margin="0,0,8,0" Padding="18,6"/>
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSave" Padding="20,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>