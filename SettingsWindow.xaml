<Window x:Class="JavaDeck.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="JavaDeck.ico"
        Title="设置" Height="640" Width="760" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnDrag">
            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                    Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource Fg}" StrokeThickness="1.2"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- 外观 -->
                <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="主题" FontSize="12" Foreground="{DynamicResource FgDim}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeLight" Content="浅色" Margin="0,0,20,0" GroupName="Theme"
                                         Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeDark" Content="深色" Margin="0,0,20,0" GroupName="Theme"
                                         Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeSystem" Content="跟随系统" GroupName="Theme"
                                         Checked="OnThemeChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <TextBlock Text="启动" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动" Margin="0,0,0,10"
                                  Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                        <CheckBox x:Name="ChkMinimized" Content="启动时最小化到托盘" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkCloseToTray" Content="关闭窗口时最小化到托盘（而非退出）"/>
                    </StackPanel>
                </Border>

                <!-- 网络代理 -->
                <TextBlock Text="网络代理" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel>
                        <CheckBox x:Name="ChkProxy" Content="使用代理下载" Margin="0,0,0,10"
                                  Checked="OnProxyToggled" Unchecked="OnProxyToggled"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="地址" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FgDim}" FontSize="12" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtProxy" Grid.Column="1" IsEnabled="False"
                                     ToolTip="例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080"/>
                            <Button x:Name="BtnTestProxy" Grid.Column="2" Content="测试" Margin="8,0,0,0"
                                    Style="{StaticResource FlatButton}" Click="OnTestProxy" IsEnabled="False"/>
                        </Grid>
                        <CheckBox x:Name="ChkBypassLocal" Content="本地地址不走代理" FontSize="11"
                                  Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <TextBlock Text="下载" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="并行分段数" FontSize="12"/>
                            <TextBlock Text="每个文件切成几段同时下载，网速好时可提高" FontSize="11"
                                       Foreground="{DynamicResource FgDim}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbSegments" Grid.Column="1" Width="90" VerticalAlignment="Center">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="12"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 行为 -->
                <TextBlock Text="行为" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoDeleteOld" Content="更新后自动删除旧版本"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource FgDim}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel"
                            Margin="0,0,8,0" Padding="18,6"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSave" Padding="22,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
