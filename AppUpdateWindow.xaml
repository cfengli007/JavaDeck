<Window x:Class="JavaDeck.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="JavaDeck.ico"
        Title="检查更新" Height="580" Width="720" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnDrag">
            <TextBlock Text="检查更新" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                    Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource Fg}" StrokeThickness="1.2"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>

                <!-- 当前状态 -->
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" FontSize="15" FontWeight="SemiBold"
                                   Text="正在检查…" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource FgDim}" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="Bar" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 版本信息 -->
                <TextBlock Text="版本信息" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock x:Name="CurrentVersionText" Grid.Row="0" Grid.Column="1"
                                   FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最新版本" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1"
                                   FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="项目地址" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RepoText" FontSize="12"
                                   Foreground="{DynamicResource Accent}" Cursor="Hand"
                                   TextTrimming="CharacterEllipsis"
                                   MouseLeftButtonDown="OnOpenRepo"/>
                    </Grid>
                </Border>

                <!-- 更新说明 -->
                <TextBlock Text="更新说明" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                    <TextBlock x:Name="ReleaseNotes" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg}"
                               Text="（检查后显示）"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnClose"
                            Margin="0,0,8,0" Padding="18,6"/>
                    <Button x:Name="ActionButton" Content="检查" Style="{StaticResource PrimaryButton}"
                            Click="OnAction" Padding="22,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
