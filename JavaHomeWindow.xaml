<Window x:Class="JavaDeck.JavaHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="JavaDeck.ico"
        Title="JAVA_HOME 设置" Height="560" Width="720" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="设置默认 JAVA_HOME" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="JAVA_HOME 决定 java 命令默认用哪个版本。被设为 JAVA_HOME 的 JDK 会从 PATH 中移除，其余 JDK 的 bin 留在 PATH 里供其它软件发现。"
                       Foreground="{DynamicResource FgDim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="当前 JAVA_HOME" FontSize="11" Foreground="{DynamicResource FgDim}"/>
                <TextBlock x:Name="CurrentHomeText" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="8">
            <ListBox x:Name="HomeList" Background="Transparent" Margin="6"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="HintText" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="不设置（清空）" Style="{StaticResource GhostButton}" Click="OnClear" Margin="0,0,8,0"/>
                <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" Margin="0,0,8,0" Padding="18,6"/>
                <Button Content="应用" Style="{StaticResource PrimaryButton}" Click="OnApply" Padding="22,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
