<Window x:Class="JavaDeck.AddJdkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="JavaDeck.ico"
        Title="添加 JDK" Height="720" Width="900" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 安装目录 -->
        <Grid Grid.Row="0" Margin="0,4,0,14">
            <StackPanel>
                <TextBlock Text="添加 JDK" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,0"/>
                <TextBlock x:Name="RootPathText" Foreground="{DynamicResource FgDim}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 筛选 -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="LTS" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgDim}" Margin="0,0,8,0"/>
                <ComboBox x:Name="FeatureCombo" Grid.Column="1" Width="110"
                          SelectionChanged="OnFeatureChanged"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="24,0,12,0">
                    <TextBlock Text="变体" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="VarStandard" Content="标准" IsChecked="True" Margin="0,0,14,0"
                              Checked="OnVariantChanged" Unchecked="OnVariantChanged"/>
                    <CheckBox x:Name="VarFull" Content="Full" Margin="0,0,14,0"
                              Checked="OnVariantChanged" Unchecked="OnVariantChanged"/>
                    <CheckBox x:Name="VarLite" Content="Lite"
                              Checked="OnVariantChanged" Unchecked="OnVariantChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="OnlyLatest" Content="只看最新" IsChecked="True"
                              Checked="OnVariantChanged" Unchecked="OnVariantChanged" Margin="0,0,14,0"/>
                    <Button x:Name="SelectAllBtn" Content="全选" Style="{StaticResource FlatButton}"
                            FontSize="11" Padding="12,4" Click="OnSelectAllClick"
                            ToolTip="全选当前列表中的所有版本"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 列表头 -->
        <Grid Grid.Row="2" Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="14" Margin="2,0,8,0"/>
            <TextBlock Grid.Column="1" Text="版本 / 变体" FontSize="11" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="大小" FontSize="11" Foreground="{DynamicResource FgDim}" Width="70" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="状态" FontSize="11" Foreground="{DynamicResource FgDim}" Width="80" VerticalAlignment="Center"/>
        </Grid>

        <!-- 版本列表 -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" CornerRadius="8">
            <ListBox x:Name="VersionList" SelectionMode="Multiple" Background="Transparent"/>
        </Border>

        <!-- 队列 -->
        <Border Grid.Row="4" x:Name="QueuePanel" Background="{DynamicResource Panel}" CornerRadius="8"
                Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="安装队列" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="清空已完成" Style="{StaticResource GhostButton}" FontSize="11"
                            HorizontalAlignment="Right" Click="OnClearFinished"/>
                </Grid>
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="QueueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <ProgressBar Value="{Binding Progress}" Height="4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                                   Foreground="{DynamicResource FgDim}" Width="52"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Content="✕" Style="{StaticResource GhostButton}" FontSize="10"
                                                Padding="6,2" Margin="4,0,0,0" Tag="{Binding}"
                                                Click="OnCancelJob"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 加载遮罩 -->
        <Border x:Name="LoadingLayer" Grid.Row="3" Background="#B3FFFFFF" Visibility="Collapsed">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LoadingRing" Width="22" Height="22" Stroke="{DynamicResource Accent}"
                             StrokeThickness="2.5" StrokeDashArray="12 8" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="加载中…" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 底栏 -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <TextBlock x:Name="HintText" Foreground="{DynamicResource FgDim}" FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" Margin="0,0,8,0" Padding="18,6"/>
                <Button x:Name="InstallButton" Content="加入队列" Style="{StaticResource PrimaryButton}"
                        Click="OnInstall" Padding="22,6" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>