<Window x:Class="JavaDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="JavaDeck.ico"
        Title="JavaDeck" Height="720" Width="1100" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"
                            NonClientFrameEdges="None"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Bg}" Padding="0">
        <Grid x:Name="ContentHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <!-- ===== 自定义标题栏（可拖动）===== -->
            <Grid Grid.Row="0" Background="{DynamicResource Bg}" x:Name="TitleBar"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="JavaDeck" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RootLabel" Foreground="{DynamicResource FgFaint}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,1,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Click="OnMinimize">
                        <Path Data="M 0 0 L 10 0" Stroke="{DynamicResource Fg}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Click="OnMaximize">
                        <Rectangle Width="10" Height="10" Stroke="{DynamicResource Fg}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Click="OnClose"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource Fg}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== 顶部菜单 ===== -->
            <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,0,1" Padding="10,0">
                <StackPanel Orientation="Horizontal" Height="34">
                    <Button Content="文件" Style="{StaticResource MenuBarButton}" Click="OnMenuFile">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource MenuBarContextMenu}">
                                <MenuItem Header="目录设置…" Click="OnChooseRoot"/>
                                <MenuItem Header="打开安装目录" Click="OnOpenRoot"/>
                                <MenuItem Header="刷新" Click="OnRefresh"/>
                                <Separator/>
                                <MenuItem Header="退出" Click="OnExit"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="JDK" Style="{StaticResource MenuBarButton}" Click="OnMenuJdk">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource MenuBarContextMenu}">
                                <MenuItem Header="添加 JDK…" Click="OnAddJdk"/>
                                <MenuItem Header="导入已有…" Click="OnImport"/>
                                <Separator/>
                                <MenuItem Header="JDK 管理…" Click="OnManageJdk"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="环境" Style="{StaticResource MenuBarButton}" Click="OnMenuEnv">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource MenuBarContextMenu}">
                                <MenuItem Header="JAVA_HOME 设置…" Click="OnJavaHomeSettings"/>
                                <MenuItem Header="PATH 排序…" Click="OnManagePath"/>
                                <MenuItem Header="查看当前环境" Click="OnShowEnv"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="更新" Style="{StaticResource MenuBarButton}" Click="OnMenuUpdate">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource MenuBarContextMenu}">
                                <MenuItem x:Name="MenuCheckUpdate" Header="立即检查更新" Click="OnCheckUpdates"/>
                                <MenuItem x:Name="MenuUpdateAll" Header="全部更新" Click="OnUpdateAll" Visibility="Collapsed"/>
                                <Separator/>
                                <MenuItem x:Name="MenuAutoUpdate" Header="自动检查更新" IsCheckable="True"
                                          IsChecked="True" Click="OnToggleAutoUpdate"/>
                                <MenuItem x:Name="MenuInterval" Header="检查频率">
                                    <MenuItem x:Name="MenuInterval6" Header="每 6 小时" IsCheckable="True" Tag="6" Click="OnPickInterval"/>
                                    <MenuItem x:Name="MenuInterval12" Header="每 12 小时" IsCheckable="True" Tag="12" Click="OnPickInterval"/>
                                    <MenuItem x:Name="MenuInterval24" Header="每 24 小时" IsCheckable="True" Tag="24" Click="OnPickInterval"/>
                                    <MenuItem x:Name="MenuInterval72" Header="每 3 天" IsCheckable="True" Tag="72" Click="OnPickInterval"/>
                                    <MenuItem x:Name="MenuInterval168" Header="每 7 天" IsCheckable="True" Tag="168" Click="OnPickInterval"/>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="工具" Style="{StaticResource MenuBarButton}" Click="OnMenuTools">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource MenuBarContextMenu}">
                                <MenuItem Header="检查 JavaDeck 更新…" Click="OnCheckAppUpdate"/>
                                <MenuItem Header="设置…" Click="OnOpenSettings"/>
                                <Separator/>
                                <MenuItem Header="关于 JavaDeck…" Click="OnAbout"/>
                                <Separator/>
                                <MenuItem Header="Minecraft 版本对照…" Click="OnShowMc"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 右侧：更新徽标 + 队列指示 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button x:Name="UpdateBadge" Style="{StaticResource BadgeButton}" Content="有更新"
                                Visibility="Collapsed" Click="OnShowUpdates"/>
                        <Button x:Name="QueueBadge" Style="{StaticResource BadgeButton}" Content="队列 0"
                                Visibility="Collapsed" Click="OnToggleQueue"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 主区：左列表 + 可选底部队列 ===== -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="8" Margin="12,12,12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                    Padding="16,10">
                                <Grid>
                                    <TextBlock Text="已安装的 JDK" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EnvSummary" HorizontalAlignment="Right" FontSize="11"
                                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                                <StackPanel x:Name="JdkList"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 实时安装队列 -->
                <Border Grid.Row="1" x:Name="QueuePanel" Background="{DynamicResource Panel}" CornerRadius="8"
                        Margin="12,0,12,8" Padding="14,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock x:Name="QueueTitle" Text="安装队列" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="清空已完成" Style="{StaticResource GhostButton}" FontSize="11"
                                        Click="OnClearFinished" Margin="0,0,6,0"/>
                                <Button Content="收起" Style="{StaticResource GhostButton}" FontSize="11"
                                        Click="OnToggleQueue"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Card}" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Background="{Binding KindBrush}">
                                                    <TextBlock Text="{Binding KindText}" FontSize="10"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="10"
                                                               Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                    <ProgressBar Value="{Binding Progress}" Height="4"/>
                                                </Grid>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                                               Foreground="{DynamicResource FgDim}" Width="56"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <Button Content="✕" Style="{StaticResource GhostButton}" FontSize="10"
                                                            Padding="6,0" Margin="4,0,0,0" Tag="{Binding}" Click="OnCancelJob"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 加载遮罩（覆盖整个内容区） -->
            <Border x:Name="BusyLayer" Grid.Row="2" Grid.RowSpan="2" Background="#B3FFFFFF"
                    Visibility="Collapsed" Panel.ZIndex="999">
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="26,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="24" Height="24">
                            <Ellipse x:Name="BusyRing" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                                     StrokeDashArray="12 8" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="BusyRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="BusyText" Text="加载中…" Margin="14,0,0,0"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource Fg}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 状态条 -->
            <Border Grid.Row="3" Background="Transparent" Margin="14,0,14,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="11"
                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="添加 JDK" Style="{StaticResource PrimaryButton}" Click="OnAddJdk" Margin="0,0,8,0" Padding="16,7"/>
                        <Button Content="导入已有" Style="{StaticResource FlatButton}" Click="OnImport" Margin="0,0,8,0" Padding="16,7"/>
                        <Button Content="JDK 管理" Style="{StaticResource FlatButton}" Click="OnManageJdk" Padding="16,7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LastCheckText" Foreground="{DynamicResource FgFaint}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="检查更新" Style="{StaticResource FlatButton}" Click="OnCheckUpdates" Padding="14,7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>