<Window x:Class="JavaDeck.McWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="JavaDeck.ico"
        Title="Minecraft 版本对照" Height="600" Width="720" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Minecraft 版本与 Java 要求" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="Hint" Text="从 Mojang 拉取版本清单，标出每个版本需要哪个 Java，并对比本机是否已具备"
                       Foreground="{DynamicResource FgDim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Button x:Name="FetchBtn" Grid.Row="1" Content="获取版本需求" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" Click="OnFetch" Margin="0,0,0,12" Padding="18,6"/>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="8" Padding="14,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Table"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="Summary" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="关闭" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                    Click="OnClose" Padding="18,6"/>
        </Grid>
    </Grid>
</Window>