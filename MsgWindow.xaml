<Window x:Class="JavaDeck.MsgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="JavaDeck.ico"
        Title="JavaDeck" SizeToContent="Height" Width="620" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border x:Name="IconBox" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="8" Padding="14,12">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Fg}" FontSize="12"
                         VerticalScrollBarVisibility="Auto"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="复制全部" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Click="OnCopy"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource FlatButton}"
                        Click="OnCancel" Margin="0,0,8,0" Padding="18,6" Visibility="Collapsed"/>
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}"
                        Click="OnOk" Padding="22,6" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>