<Window x:Class="JavaDeck.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="JavaDeck.ico"
        Title="关于 JavaDeck" Height="540" Width="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnDrag">
            <TextBlock Text="关于 JavaDeck" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                    Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource Fg}" StrokeThickness="1.2"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>

                <!-- 应用标识 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource Accent}">
                        <TextBlock Text="J" FontSize="30" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="JavaDeck" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource FgDim}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 信息表 -->
                <TextBlock Text="信息" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="技术栈" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="WPF / .NET 8" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="JDK 来源" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="BellSoft Liberica（LTS 8 / 11 / 17 / 21 / 25）"
                                   FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="许可证" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="GPL-3.0" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="项目地址" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RepoText" FontSize="12"
                                   Foreground="{DynamicResource Accent}" Cursor="Hand"
                                   TextTrimming="CharacterEllipsis"
                                   MouseLeftButtonDown="OnOpenRepo"/>
                    </Grid>
                </Border>

                <!-- 许可声明 -->
                <TextBlock Text="许可" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Copyright (C) 2026 JavaDeck Contributors"
                                   FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"
                                   LineHeight="19"
                                   Text="本程序是自由软件：你可以依据自由软件基金会发布的 GNU 通用公共许可证第 3 版（或你选择的任何更新版本）的条款重新分发和/或修改它。&#10;&#10;本程序基于“有用”的目的分发，但不提供任何担保，甚至不提供适销性或特定用途适用性的默示担保。详见 GNU 通用公共许可证。&#10;&#10;LICENSE 全文见仓库根目录的 LICENSE 文件。"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource FgDim}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="查看许可证" Style="{StaticResource FlatButton}" Click="OnViewLicense"
                            Margin="0,0,8,0" Padding="16,6"/>
                    <Button Content="打开项目主页" Style="{StaticResource PrimaryButton}" Click="OnOpenRepo"
                            Padding="18,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
